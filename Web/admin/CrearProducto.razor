@page "/admin/productos/nuevo"
@using Application.DTOs
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>Nuevo Producto - Admin</PageTitle>

<div class="page-header">
    <h1 class="page-title">Nuevo producto</h1>
    <p class="page-subtitle">Completa los datos para publicar en el catálogo</p>
</div>

<div class="form-panel">
    <div class="panel">
        <div class="panel__header">
            <h2>Información del producto</h2>
        </div>
        <div class="panel__body">
            <EditForm Model="nuevoProducto" OnValidSubmit="GuardarProducto">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Nombre del producto</label>
                    <InputText class="form-control" @bind-Value="nuevoProducto.Nombre" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <InputTextArea class="form-control" @bind-Value="nuevoProducto.Descripcion" rows="3" />
                </div>

                <div class="mb-3">
                    <label class="form-label">URL de la imagen</label>
                    <InputText class="form-control" @bind-Value="nuevoProducto.ImagenUrl"
                               placeholder="https://ejemplo.com/imagen.jpg" />
                    <div class="form-text">Enlace directo a una imagen en formato JPG o PNG</div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Precio ($)</label>
                        <InputNumber class="form-control" @bind-Value="nuevoProducto.Precio" required min="0" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Stock inicial</label>
                        <InputNumber class="form-control" @bind-Value="nuevoProducto.Stock" required min="0" />
                    </div>
                </div>

                <div class="form-actions">
                    <a href="/admin/productos" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar producto")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private ProductoDto nuevoProducto = new ProductoDto();
    private bool guardando = false;

    private async Task GuardarProducto()
    {
        guardando = true;
        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/Productos", nuevoProducto);

            if (respuesta.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/admin/productos");
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                Console.WriteLine("Error al guardar: " + error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error crítico: " + ex.Message);
        }
        finally
        {
            guardando = false;
        }
    }
}
