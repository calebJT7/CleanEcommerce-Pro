@inject Web.Services.CarritoService Carrito
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<div class="page">
    <header class="app-header">
        <div class="app-header__inner">
            <a class="app-brand" href="/">
                <span class="app-brand__mark">CE</span>
                <span>CleanEcommerce</span>
            </a>

            <button type="button" class="app-navbar-toggler" @onclick="ToggleMobileNav" aria-label="Menú">
                <span class="app-navbar-toggler-icon"></span>
            </button>

            <div class="app-nav-actions @(mobileNavOpen ? "is-open" : "")">
                <AuthorizeView>
                    <Authorized>
                        @{
                            var emailLogueado = context.User.FindFirst(c => c.Type.Contains("email"))?.Value;
                        }

                        @if (!string.IsNullOrEmpty(emailLogueado))
                        {
                            <span class="app-user">@emailLogueado</span>
                        }

                        @if (emailLogueado == "calebtoledo375@gmail.com")
                        {
                            <nav class="app-admin-nav" aria-label="Administración">
                                <span class="d-none d-md-inline text-secondary small me-1" style="color:#64748b!important;font-size:0.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Admin</span>
                                <a href="/admin" class="nav-link-item @(EsRutaActiva("/admin", exact: true) ? "active" : "")">Dashboard</a>
                                <a href="/admin/productos" class="nav-link-item @(EsRutaActiva("/admin/productos") ? "active" : "")">Productos</a>
                                <a href="/admin/pedidos" class="nav-link-item @(EsRutaActiva("/admin/pedidos") ? "active" : "")">Pedidos</a>
                            </nav>
                        }

                        <button type="button" class="btn btn-sm btn-header-danger" @onclick="CerrarSesion">
                            Cerrar sesión
                        </button>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-sm btn-header-ghost">
                            Iniciar sesión
                        </a>
                    </NotAuthorized>
                </AuthorizeView>

                <a href="/carrito" class="btn-cart text-decoration-none">
                    Carrito
                    <span class="btn-cart__count">@Carrito.ObtenerCantidad()</span>
                </a>
            </div>
        </div>
    </header>

    @if (EsRutaAdmin)
    {
        <div class="app-shell-admin">
            <aside class="admin-sidebar d-none d-lg-block" aria-label="Panel de administración">
                <p class="admin-sidebar__label">Panel</p>
                <a href="/admin" class="admin-sidebar__link @(EsRutaActiva("/admin", exact: true) ? "active" : "")">Dashboard</a>
                <a href="/admin/productos" class="admin-sidebar__link @(EsRutaActiva("/admin/productos") ? "active" : "")">Productos</a>
                <a href="/admin/pedidos" class="admin-sidebar__link @(EsRutaActiva("/admin/pedidos") ? "active" : "")">Pedidos</a>
                <div class="admin-sidebar__divider"></div>
                <a href="/" class="admin-sidebar__link">Volver a la tienda</a>
            </aside>
            <main class="admin-main">
                @Body
            </main>
        </div>
    }
    else
    {
        <main class="app-content">
            <div class="app-content__inner">
                @Body
            </div>
        </main>
    }
</div>

@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

@code {
    private bool mobileNavOpen;

    private bool EsRutaAdmin =>
        Navigation.Uri.Contains("/admin", StringComparison.OrdinalIgnoreCase);

    private bool EsRutaActiva(string path, bool exact = false)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        var normalized = path.TrimStart('/');

        if (exact)
            return relative.Equals(normalized, StringComparison.OrdinalIgnoreCase);

        return relative.StartsWith(normalized, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleMobileNav() => mobileNavOpen = !mobileNavOpen;

    private async Task CerrarSesion()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
        Navigation.NavigateTo("/", forceLoad: true);
    }

    protected override void OnInitialized()
    {
        Carrito.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        mobileNavOpen = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        Carrito.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
