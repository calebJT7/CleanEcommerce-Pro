@page "/admin/pedidos"
@attribute [Authorize(Roles = "Admin")]
@using Application.DTOs
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Net.Http.Headers

<PageTitle>Control de Pedidos - Admin</PageTitle>

<div class="page-header">
    <h1 class="page-title">Pedidos</h1>
    <p class="page-subtitle">Gestiona el estado de las ventas</p>
</div>

@if (pedidos == null)
{
    <div class="state-loading">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando pedidos...</p>
    </div>
}
else if (!pedidos.Any())
{
    <div class="state-empty">
        <p class="state-empty__title">Sin pedidos registrados</p>
        <p class="state-empty__text">Los pedidos de clientes aparecerán aquí cuando se realicen compras.</p>
    </div>
}
else
{
    <div class="panel panel__body--flush">
        <div class="data-table-wrap">
            <table class="table data-table mb-0">
                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ped in pedidos)
                    {
                        <tr>
                            <td class="fw-medium text-muted">#@ped.Id</td>
                            <td>@ped.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@ped.ClienteEmail</td>
                            <td class="fw-medium">$@ped.Total.ToString("N2")</td>
                            <td>
                                <span class="status-pill status-pill--warning">@ped.Estado</span>
                            </td>
                            <td class="text-end">
                                @if (ped.Estado == "Pendiente" || string.IsNullOrEmpty(ped.Estado))
                                {
                                    <button type="button" class="btn btn-sm btn-primary me-1"
                                            @onclick='() => CambiarEstado(ped.Id, "Enviado")'>
                                        Marcar enviado
                                    </button>
                                }
                                else if (ped.Estado == "Enviado")
                                {
                                    <button type="button" class="btn btn-sm btn-primary me-1"
                                            @onclick='() => CambiarEstado(ped.Id, "Entregado")'>
                                        Marcar entregado
                                    </button>
                                }
                                else
                                {
                                    <span class="status-pill status-pill--muted me-1">Finalizado</span>
                                }

                                <a href="/admin/pedidos/@ped.Id" class="btn btn-sm btn-outline-primary">
                                    Ver detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<PedidoAdminDto>? pedidos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                pedidos = await Http.GetFromJsonAsync<List<PedidoAdminDto>>("api/Pedidos");
            }
            else
            {
                Console.WriteLine("No se encontró el token de seguridad.");
                pedidos = new List<PedidoAdminDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar pedidos: " + ex.Message);
            pedidos = new List<PedidoAdminDto>();
        }
    }
    private async Task CambiarEstado(int id, string nuevoEstado)
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var peticion = new { NuevoEstado = nuevoEstado };

            var respuesta = await Http.PutAsJsonAsync($"api/Pedidos/{id}/estado", peticion);

            if (respuesta.IsSuccessStatusCode)
            {
                await OnInitializedAsync();
            }
            else
            {
                Console.WriteLine("Error al cambiar el estado del pedido.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }
    }
}
