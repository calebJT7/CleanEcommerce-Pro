@page "/carrito"
@using Application.DTOs
@using Microsoft.AspNetCore.Components
@inject Web.Services.CarritoService MotorCarrito
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@using System.Net.Http.Headers

<PageTitle>Mi Carrito - CleanEcommerce</PageTitle>

<div class="page-header">
    <h1 class="page-title">Carrito de compras</h1>
    <p class="page-subtitle">Revisa los artículos antes de finalizar tu pedido</p>
</div>

@if (compraExitosa)
{
    <div class="state-success">
        <h2 class="h5 fw-semibold mb-2">Compra realizada con éxito</h2>
        <p class="text-secondary mb-4">Tu pedido ha sido procesado correctamente.</p>
        <a href="/" class="btn btn-primary">Volver a la tienda</a>
    </div>
}
else if (MotorCarrito.ObtenerCantidad() == 0)
{
    <div class="state-empty">
        <p class="state-empty__title">Tu carrito está vacío</p>
        <p class="state-empty__text">Aún no has agregado productos. Explora el catálogo para comenzar.</p>
        <a href="/" class="btn btn-primary">Ir al catálogo</a>
    </div>
}
else if (productosEnCarrito == null)
{
    <div class="state-loading">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando detalles de tus productos...</p>
    </div>
}
else
{
    <div class="cart-layout">
        <div class="panel panel__body--flush">
            <div class="data-table-wrap">
                <table class="table data-table mb-0">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="text-end">Precio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in productosEnCarrito)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                        {
                                            <img src="@item.ImagenUrl" alt="" class="thumb-sm" />
                                        }
                                        else
                                        {
                                            <div class="thumb-placeholder">—</div>
                                        }
                                        <span class="fw-medium">@item.Nombre</span>
                                    </div>
                                </td>
                                <td class="text-end fw-medium">$@item.Precio.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <aside class="cart-summary">
            <h2 class="h6 fw-semibold mb-4">Resumen</h2>
            <div class="cart-summary__row">
                <span>Artículos</span>
                <span>@productosEnCarrito.Count</span>
            </div>
            <div class="cart-summary__total">
                <span>Total</span>
                <span>$@totalCarrito.ToString("N2")</span>
            </div>

            @if (procesandoPago)
            {
                <button type="button" class="btn btn-secondary" disabled>
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    Procesando...
                </button>
            }
            else
            {
                <button type="button" class="btn btn-primary" @onclick="ProcesarPago">
                    Proceder al pago
                </button>
            }
        </aside>
    </div>
}

@code {
    private List<ProductoDto>? productosEnCarrito;
    private decimal totalCarrito = 0;

    protected override async Task OnInitializedAsync()
    {
        MotorCarrito.OnChange += StateHasChanged;
        await CargarDetallesDelCarrito();
    }

    private async Task CargarDetallesDelCarrito()
    {
        try
        {
            var todosLosProductos = await Http.GetFromJsonAsync<List<ProductoDto>>("api/Productos");

            if (todosLosProductos != null)
            {
                productosEnCarrito = todosLosProductos
                    .Where(p => MotorCarrito.ProductosId.Contains(p.Id))
                    .ToList();

                totalCarrito = productosEnCarrito.Sum(p => p.Precio);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar el carrito: " + ex.Message);
            productosEnCarrito = new List<ProductoDto>();
        }
    }

    private bool procesandoPago = false;
    private bool compraExitosa = false;

    private async Task ProcesarPago()
    {
        procesandoPago = true;

        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");

            if (!string.IsNullOrEmpty(token))
            {
                token = token.Replace("\"", "");
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var nuevoPedido = new { ProductoIds = MotorCarrito.ProductosId };

            var respuesta = await Http.PostAsJsonAsync("api/Pedidos", nuevoPedido);
            if (respuesta.IsSuccessStatusCode)
            {
                MotorCarrito.VaciarCarrito();
                compraExitosa = true;
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                Console.WriteLine($"Error al comprar: {respuesta.StatusCode} - {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error de conexión: " + ex.Message);
        }
        finally
        {
            procesandoPago = false;
        }
    }
}
