@page "/"
@using Application.DTOs
@using Microsoft.AspNetCore.Components
@inject HttpClient Http
@inject Web.Services.CarritoService Carrito

<PageTitle>Inicio - CleanEcommerce</PageTitle>

<div class="catalog-toolbar">
    <div>
        <h1 class="page-title">Catálogo</h1>
        <p class="page-subtitle">Explora nuestros productos disponibles</p>
    </div>
</div>

@if (productos == null)
{
    <div class="state-loading">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando productos...</p>
    </div>
}
else if (!productos.Any())
{
    <div class="state-empty">
        <p class="state-empty__title">Sin productos por ahora</p>
        <p class="state-empty__text">El catálogo está vacío. Vuelve más tarde para ver nuevas incorporaciones.</p>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var producto in productos)
        {
            <article class="product-card">
                <div class="product-card__media">
                    @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                    {
                        <img src="@producto.ImagenUrl" alt="@producto.Nombre" loading="lazy" />
                    }
                    else
                    {
                        <div class="product-card__placeholder">Sin imagen</div>
                    }
                </div>
                <div class="product-card__body">
                    <h2 class="product-card__title">@producto.Nombre</h2>
                    <p class="product-card__price">$@producto.Precio.ToString("N2")</p>
                </div>
                <div class="product-card__actions">
                    <a href="/producto/@producto.Id" class="btn btn-outline-secondary btn-sm w-100">
                        Ver detalles
                    </a>
                    <button type="button" class="btn btn-primary btn-sm w-100"
                            @onclick="() => Carrito.AgregarAlCarrito(producto.Id)">
                        Agregar al carrito
                    </button>
                </div>
            </article>
        }
    </div>
}

@code {
    private List<ProductoDto>? productos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            productos = await Http.GetFromJsonAsync<List<ProductoDto>>("api/Productos");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar productos: " + ex.Message);
            productos = new List<ProductoDto>();
        }
    }
}
