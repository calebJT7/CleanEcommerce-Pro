@page "/admin/productos/editar/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@using Application.DTOs
@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>Editar Producto - Admin</PageTitle>

<div class="page-header">
    <h1 class="page-title">Editar producto #@Id</h1>
    <p class="page-subtitle">Actualiza la información del catálogo</p>
</div>

<div class="form-panel">
    <div class="panel">
        <div class="panel__body">
            @if (cargando)
            {
                <div class="state-loading py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p>Cargando datos del producto...</p>
                </div>
            }
            else if (productoAEditar == null)
            {
                <div class="alert alert-danger">El producto no existe.</div>
                <a href="/admin/productos" class="btn btn-outline-secondary">Volver</a>
            }
            else
            {
                <EditForm Model="productoAEditar" OnValidSubmit="GuardarCambios">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Nombre del producto</label>
                        <InputText class="form-control" @bind-Value="productoAEditar.Nombre" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <InputTextArea class="form-control" @bind-Value="productoAEditar.Descripcion" rows="3" />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Precio ($)</label>
                            <InputNumber class="form-control" @bind-Value="productoAEditar.Precio" required min="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Stock actual</label>
                            <InputNumber class="form-control" @bind-Value="productoAEditar.Stock" required min="0" />
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/admin/productos" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @(guardando ? "Actualizando..." : "Actualizar producto")
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ProductoDto? productoAEditar;
    private bool cargando = true;
    private bool guardando = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            productoAEditar = await Http.GetFromJsonAsync<ProductoDto>($"api/Productos/{Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar el producto: " + ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarCambios()
    {
        guardando = true;
        try
        {
            var respuesta = await Http.PutAsJsonAsync($"api/Productos/{Id}", productoAEditar);

            if (respuesta.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/admin/productos");
            }
            else
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                Console.WriteLine("Error al actualizar: " + error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error crítico: " + ex.Message);
        }
        finally
        {
            guardando = false;
        }
    }
}
