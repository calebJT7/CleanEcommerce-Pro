@page "/producto/{Id:int}"
@using Application.DTOs
@inject HttpClient Http

<PageTitle>@(producto?.Nombre ?? "Producto") - CleanEcommerce</PageTitle>

@if (producto == null)
{
    <div class="state-loading">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando producto...</p>
    </div>
}
else
{
    <div class="product-detail">
        <div class="product-detail__gallery">
            @if (!string.IsNullOrEmpty(producto.ImagenUrl))
            {
                <img src="@producto.ImagenUrl" alt="@producto.Nombre" />
            }
            else
            {
                <div class="product-detail__placeholder">Sin imagen disponible</div>
            }
        </div>

        <div class="product-detail__info">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@producto.Nombre</li>
                </ol>
            </nav>

            <h1 class="product-detail__name">@producto.Nombre</h1>
            <p class="product-detail__price">$@producto.Precio.ToString("N2")</p>

            <p class="product-detail__desc">
                @(string.IsNullOrEmpty(producto.Descripcion)
                    ? "Este producto no tiene descripción."
                    : producto.Descripcion)
            </p>

            <div class="mb-4">
                <span class="text-secondary small fw-medium me-2">Disponibilidad</span>
                @if (producto.Stock > 0)
                {
                    <span class="stock-badge stock-badge--in">@producto.Stock en stock</span>
                }
                else
                {
                    <span class="stock-badge stock-badge--out">Agotado</span>
                }
            </div>

            <button type="button" class="btn btn-primary w-100" disabled="@(producto.Stock <= 0)">
                Agregar al carrito
            </button>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ProductoDto? producto;

    protected override async Task OnInitializedAsync()
    {
        producto = await Http.GetFromJsonAsync<ProductoDto>($"api/Productos/{Id}");
    }
}
