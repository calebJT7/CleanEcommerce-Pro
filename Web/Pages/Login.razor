@page "/login"
@using Application.DTOs
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Iniciar sesión - CleanEcommerce</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__brand">
            <span class="app-brand__mark d-inline-flex">CE</span>
            <h1>CleanEcommerce</h1>
            <p>Ingresa con tu cuenta para continuar</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-4" role="alert">@errorMessage</div>
        }

        <div class="mb-3">
            <label class="form-label" for="login-email">Correo electrónico</label>
            <input id="login-email" type="email" class="form-control" @bind="loginDto.Email" autocomplete="email" />
        </div>

        <div class="mb-4">
            <label class="form-label" for="login-password">Contraseña</label>
            <input id="login-password" type="password" class="form-control" @bind="loginDto.Password" autocomplete="current-password" />
        </div>

        <button type="button" class="btn btn-primary w-100" @onclick="ManejarLogin">
            Ingresar
        </button>
    </div>
</div>

@code {
    private UsuarioLoginDto loginDto = new UsuarioLoginDto();
    private string errorMessage = "";

    private async Task ManejarLogin()
    {
        errorMessage = "";

        var response = await Http.PostAsJsonAsync("api/Usuarios/login", loginDto);

        if (response.IsSuccessStatusCode)
        {
            var resultado = await response.Content.ReadFromJsonAsync<LoginResult>();

            if (resultado != null)
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "authToken", resultado.Token);
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                errorMessage = "Error al procesar la respuesta del servidor.";
            }
        }
        else
        {
            errorMessage = "Correo o contraseña incorrectos. Intenta de nuevo.";
        }
    }

    public class LoginResult
    {
        public string Mensaje { get; set; } = "";
        public string Token { get; set; } = "";
    }
}
