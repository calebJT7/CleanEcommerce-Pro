@page "/admin/productos"
@using Application.DTOs
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http
@inject IJSRuntime JS
<PageTitle>Gestión de Productos - Admin</PageTitle>

<div class="page-header page-header--row">
    <div>
        <h1 class="page-title">Productos</h1>
        <p class="page-subtitle">Administra el inventario de la tienda</p>
    </div>
    <a href="/admin/productos/nuevo" class="btn btn-primary">
        Nuevo producto
    </a>
</div>

@if (productos == null)
{
    <div class="state-loading">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando inventario...</p>
    </div>
}
else if (!productos.Any())
{
    <div class="state-empty">
        <p class="state-empty__title">Sin productos registrados</p>
        <p class="state-empty__text">Comienza agregando el primer producto a tu catálogo.</p>
        <a href="/admin/productos/nuevo" class="btn btn-primary">Crear producto</a>
    </div>
}
else
{
    <div class="panel panel__body--flush">
        <div class="data-table-wrap">
            <table class="table data-table mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Imagen</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in productos)
                    {
                        <tr>
                            <td class="text-muted">#@prod.Id</td>
                            <td class="fw-medium">@prod.Nombre</td>
                            <td>
                                @if (!string.IsNullOrEmpty(prod.ImagenUrl))
                                {
                                    <img src="@prod.ImagenUrl" alt="" class="thumb-sm" />
                                }
                                else
                                {
                                    <span class="status-pill status-pill--muted">Sin foto</span>
                                }
                            </td>
                            <td class="fw-medium">$@prod.Precio.ToString("N2")</td>
                            <td>
                                @if (prod.Stock == 0)
                                {
                                    <span class="status-pill" style="background:var(--color-danger-soft);color:var(--color-danger);">Sin stock</span>
                                }
                                else if (prod.Stock < 5)
                                {
                                    <span class="status-pill status-pill--warning">Bajo: @prod.Stock</span>
                                }
                                else
                                {
                                    <span class="status-pill">@prod.Stock</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/admin/productos/editar/@prod.Id" class="btn btn-sm btn-outline-primary me-1">
                                    Editar
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => Eliminar(prod.Id, prod.Nombre)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private async Task Eliminar(int id, string nombre)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Estás seguro de que quieres eliminar '{nombre}' de tu inventario? Esta acción no se puede deshacer.");

        if (confirmado)
        {
            var respuesta = await Http.DeleteAsync($"api/Productos/{id}");

            if (respuesta.IsSuccessStatusCode)
            {
                await CargarInventario();
            }
            else
            {
                Console.WriteLine("Error al intentar borrar el producto.");
            }
        }
    }
    private List<ProductoDto>? productos;

    protected override async Task OnInitializedAsync()
    {
        await CargarInventario();
    }

    private async Task CargarInventario()
    {
        try
        {
            productos = await Http.GetFromJsonAsync<List<ProductoDto>>("api/Productos");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar inventario: " + ex.Message);
            productos = new List<ProductoDto>();
        }
    }
}
