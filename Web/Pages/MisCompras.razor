@page "/mis-compras"
@using System.Net.Http.Headers
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Mis Compras - CleanEcommerce</PageTitle>

<div class="page-header">
    <h1 class="page-title">Historial de compras</h1>
    <p class="page-subtitle">Consulta el estado de tus pedidos anteriores</p>
</div>

@if (cargando)
{
    <div class="state-loading">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Buscando tus pedidos...</p>
    </div>
}
else if (misPedidos == null || !misPedidos.Any())
{
    <div class="state-empty">
        <p class="state-empty__title">Aún no tienes compras</p>
        <p class="state-empty__text">Cuando realices un pedido, aparecerá aquí con su detalle.</p>
        <a href="/" class="btn btn-primary">Ir a la tienda</a>
    </div>
}
else
{
    <div class="order-list">
        @foreach (var pedido in misPedidos)
        {
            <div class="order-item">
                <div>
                    <p class="order-item__id mb-1">Pedido #@pedido.Id</p>
                    <span class="status-pill">Completado</span>
                </div>
                <div class="text-end">
                    <span class="fw-semibold fs-5">$@pedido.Total</span>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool cargando = true;
    private List<dynamic>? misPedidos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");

            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                misPedidos = await Http.GetFromJsonAsync<List<dynamic>>("api/Pedidos");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar pedidos: " + ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }
}
